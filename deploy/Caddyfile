# GrammarChecker 反向代理配置（无域名 · IP 直连场景）
#
# 安装：本文件放到 /etc/caddy/Caddyfile，然后 systemctl reload caddy
#
# 为什么没有域名也要上 TLS：
#   登录口令与语法检查的正文内容走 HTTP 等于明文发在公网上。TLS 是最低成本的必要保护。
# 为什么用自签而不是 Let's Encrypt：后者不向 IP 地址签发证书，无域名只能自签。
#   副作用是浏览器首次访问提示「不安全」，手动点「继续前往」即可——
#   这是自签证书的正常现象，不是配置错误。
#
# 用户认证说明（2026-09-29 多用户体系）：
#   认证由后端登录页完成（会话 Cookie，见 README「账号与认证」），
#   本文件不再配置 Caddy basic_auth——双层认证会导致两次登录，已移除。
#   手机浏览器首次访问时点「高级 → 继续前往」接受自签证书即可。
#
# ── 证书配置说明（2026-10-07 实测修正，务必按此执行）────────────────────
# 为什么不用 `tls internal`：
#   1) `:443` 不带主机名时 Caddy **不会签发站点证书**（只生成 CA 根证书），
#      对外握手必然失败；
#   2) 改成 `https://<IP>` 后 Caddy 能签发，但**仅对携带 SNI 的请求生效**。
#      而手机浏览器访问 IP 地址时通常**不发送 SNI**，Caddy 无法匹配站点 →
#      握手被拒（TLSV1_ALERT_INTERNAL_ERROR / alert number 80）。
#      该现象已实测确认：不带 SNI 失败、带 -servername 成功。
#
# 正确做法：显式自签一张覆盖 IP 的证书并直接加载，两种访问方式都能握手成功。
# 生成命令（SAN 必须含 IP，否则证书校验失败）：
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/caddy/gc.key \
#     -out /etc/caddy/gc.crt -days 3650 -subj "/CN=<服务器IP>" \
#     -addext "subjectAltName=IP:<服务器IP>,DNS:localhost,IP:127.0.0.1"
#   chown caddy:caddy /etc/caddy/gc.key /etc/caddy/gc.crt && chmod 640 /etc/caddy/gc.key
# 注意私钥属主必须是 caddy，否则 Caddy 报 permission denied 起不来。
#
# 无 SNI 验证方法（不带 -servername）：
#   openssl s_client -connect <服务器IP>:443 </dev/null | grep 'Cipher is'

# HTTP 一律跳转到 HTTPS
:80 {
	redir https://{host}{uri} permanent
}

https://115.159.95.58, :443 {
	# 显式自签证书（含 IP SAN）——覆盖带 SNI 与不带 SNI 两种访问方式
	tls /etc/caddy/gc.crt /etc/caddy/gc.key

	# 反代到仅监听回环的后端（见 grammarchecker.service 的 -addr 参数）
	reverse_proxy 127.0.0.1:8899

	# 不对外暴露服务端软件与版本 + 基础安全响应头（2026-09-29 加固）
	# 注：未加 CSP——前端 Vue 运行时模板编译需要 unsafe-eval，强加等同虚设
	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
